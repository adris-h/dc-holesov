rules_version = '2';

// Pravidla pro DC Holešov – účty, profily a přihlášky na turnaje.
// Nasazení: Firebase konzole → Firestore → Rules (vložit obsah), nebo `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Admin = přihlášený uživatel, který má dokument admins/{uid} (zakládá se ručně v konzoli).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function nonEmptyString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // ---------------------------------------------------------------
    // Seznam adminů – každý si smí přečíst jen svůj dokument. Zápis jen z konzole.
    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // ---------------------------------------------------------------
    // Profil uživatele (účet si může založit kdokoli)
    match /users/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['name', 'nickname', 'club', 'createdAt', 'updatedAt'])
          && nonEmptyString(d.name, 80)
          && optionalString(d, 'nickname', 40)
          && optionalString(d, 'club', 80)
          && d.updatedAt == request.time;
      }

      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Veřejná část přihlášky na turnaj
    match /registrations/{id} {
      function isOwner() {
        return signedIn() && resource.data.get('uid', null) == request.auth.uid;
      }

      // Veřejně jen schválené; vlastník vidí své; admin vše
      allow read: if resource.data.status == 'accepted' || isOwner() || isAdmin();

      // Kdokoli (i bez účtu) může poslat přihlášku – vždy jako 'pending', s časem serveru,
      // a spolu s kontaktem ve stejné dávce (registrationContacts/{id}).
      // Pokud je vyplněné uid, musí patřit přihlášenému uživateli.
      allow create: if request.resource.data.keys().hasOnly(['tournament', 'name', 'nickname', 'club', 'status', 'createdAt', 'uid'])
        && nonEmptyString(request.resource.data.tournament, 100)
        && nonEmptyString(request.resource.data.name, 80)
        && optionalString(request.resource.data, 'nickname', 40)
        && optionalString(request.resource.data, 'club', 80)
        && (!('uid' in request.resource.data) || isSelf(request.resource.data.uid))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/registrationContacts/$(id));

      // Admin mění jen stav (a čas rozhodnutí)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['pending', 'accepted', 'rejected']
        && request.resource.data.decidedAt == request.time;

      // Admin smaže cokoli; vlastník jen svou čekající přihlášku (stažení)
      allow delete: if isAdmin() || (isOwner() && resource.data.status == 'pending');
    }

    // ---------------------------------------------------------------
    // Kontakt k přihlášce – soukromý, čte jen admin
    match /registrationContacts/{id} {
      function registration() {
        return get(/databases/$(database)/documents/registrations/$(id)).data;
      }

      allow read: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['tournament', 'contact'])
        && nonEmptyString(request.resource.data.contact, 120)
        && nonEmptyString(request.resource.data.tournament, 100)
        // musí vznikat spolu s novou čekající přihláškou se stejným id a turnajem
        && !exists(/databases/$(database)/documents/registrations/$(id))
        && getAfter(/databases/$(database)/documents/registrations/$(id)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/registrations/$(id)).data.tournament == request.resource.data.tournament;

      // Admin; nebo vlastník spolu se stažením své čekající přihlášky
      allow delete: if isAdmin()
        || (signedIn()
          && registration().get('uid', null) == request.auth.uid
          && registration().status == 'pending');

      allow update: if false;
    }

    // Vše ostatní zakázáno
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
